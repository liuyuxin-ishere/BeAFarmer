# Full Unity project repository. Keep Assets/.meta, Packages, ProjectSettings,
# Server projects, Shared proto/config sources and Tools (including required DLLs).
# Unity cache rules follow github/gitignore Unity.gitignore.
# Root /*.csproj, /*.sln and /*.slnx stay narrow so Server source projects remain.
# Blender authoring files and explanation documents are never published.
/Library/
/Temp/
/Logs/
/UserSettings/
/Build/
/Builds/
/Bundles/
/MemoryCaptures/
/Recordings/
/ExportedObj/

# Generated IDE files at Unity root; Server/*.csproj and *.sln remain source.
/*.csproj
/*.sln
/*.slnx
/.vs/
/.idea/
/.vscode/
/.cursor/
/.codex/
/.agents/
/.claude/
.gradle/
**/bin/
**/obj/
**/TestResults/
**/__pycache__/
*.py[cod]
*.tmp
*.bak
*.user
*.userprefs
*.suo
*.opendb
*.VC.db
*.pid
*.log
*.jsonl

