# Unity .gitignore
# 本文件仅作用于 Assets 子目录；工程根级规则见 ../.gitignore。
# Assets/.meta 与运行所需插件DLL保留，生成缓存和本地凭证排除。

/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/

# 体积大，且可能含敏感数据
/[Mm]emoryCaptures/
/[Rr]ecordings/

# Asset Store 工具
/[Aa]ssetStoreTools*

# JetBrains Rider 自动生成
/[Pp]lugins/Editor/JetBrains*

# IDE / 构建缓存
.vs/
.gradle/
.consulo/
ExportedObj/

*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

*.pidb.meta
*.pdb.meta
*.mdb.meta

sysinfo.txt

*.apk
*.aab
*.unitypackage
*.app

crashlytics-build.properties

# Addressables 打包产物
/[Aa]ddressable[Aa]ssets[Dd]ata/*/*.bin*

# Android 临时 StreamingAssets
/[Ss]treamingAssets/aa.meta
/[Ss]treamingAssets/aa/*

# 系统垃圾文件
.DS_Store
Thumbs.db
desktop.ini
ehthumbs.db
Desktop.ini

# 密钥与本地环境
.env
.env.*
*.pfx
*.snk
credentials.json
secrets.json

# Unity TestRunner temporary scenes and generated resource packages.
/InitTestScene*.unity
/InitTestScene*.unity.meta
/StreamingAssets/yoo/
/StreamingAssets/yoo.meta
*.private
m1-token.*
*.db
*.db-*
*.sqlite*
*.log
*.jsonl
